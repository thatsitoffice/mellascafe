---
const faqs = [
  {
    q: "Brauche ich eine Reservierung?",
    a: "Am Wochenende empfehlen wir eine Reservierung. Unter der Woche finden meist auch spontan Plätze.",
  },
  {
    q: "Gibt es vegetarische Optionen?",
    a: "Ja — sprechen Sie unser Team gern auf Allergien und Präferenzen an.",
  },
  {
    q: "Kann ich private Feiern buchen?",
    a: "Abschnitte und kleinere Events sind nach Absprache möglich. Schreiben Sie uns über das Kontaktformular.",
  },
];
---

<section class="relative py-24 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="reveal max-w-2xl">
      <h2 class="font-display text-3xl font-semibold text-stone-50 md:text-4xl">
        Häufige Fragen
      </h2>
      <p class="mt-4 text-stone-400 md:text-lg">
        Kurz und klar — wenn etwas fehlt, melden Sie sich direkt.
      </p>
    </div>
    <div class="mt-12 max-w-3xl space-y-4">
      {
        faqs.map((item, i) => (
          <details
            class:list={[
              "reveal group rounded-2xl border border-white/10 bg-ink-800/40 px-6 py-4 transition hover:border-gold-500/25 open:border-gold-500/30 open:bg-ink-800/70",
              i === 1 && "reveal-delay-1",
              i === 2 && "reveal-delay-2",
            ]}
          >
            <summary class="cursor-pointer list-none font-medium text-stone-100 outline-none transition group-hover:text-gold-200 [&::-webkit-details-marker]:hidden">
              <span class="flex items-center justify-between gap-4">
                {item.q}
                <span class="text-xs font-semibold uppercase tracking-widest text-stone-500 group-open:text-gold-300">
                  Details
                </span>
              </span>
            </summary>
            <p class="mt-3 text-sm text-stone-400">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
