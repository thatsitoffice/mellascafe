---
import { site } from "@/config/site";

const categories = [
  {
    name: "Café & Snacks",
    items: [
      { n: "Frühstück & Brunch", d: "Saisonal, regional ergänzt." },
      { n: "Kuchen & Patisserie", d: "Täglich frisch — solange Vorrat reicht." },
      { n: "Kleine Speisen", d: "Ideal zum Teilen oder für den kleinen Hunger." },
    ],
  },
  {
    name: "Bar & Lounge",
    items: [
      { n: "Signature Cocktails", d: "Hauskreationen mit klaren Aromen." },
      { n: "Wein & Schaumwein", d: "Kuratierte Gläser und Flaschen." },
      { n: "Spirituosen & Longdrinks", d: "Klassiker und ruhige Alternativen." },
    ],
  },
];
---

<section id="karte" class="relative py-24 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-semibold text-stone-50 md:text-4xl">
          Speise- & Getränkekarte
        </h2>
        <p class="mt-4 text-stone-400 md:text-lg">
          Ein Auszug — die vollständige Karte liegt für Sie als PDF bereit oder
          direkt vor Ort in den Händen.
        </p>
      </div>
      <a
        href={site.menuPdf}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full border border-gold-500/40 bg-gold-500/10 px-6 py-3 text-sm font-semibold text-gold-300 transition hover:bg-gold-500/20 hover:text-gold-200"
      >
        PDF-Getränkekarte öffnen
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          />
        </svg>
      </a>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      {
        categories.map((cat, ci) => (
          <div
            class:list={[
              "reveal rounded-2xl border border-white/10 bg-gradient-to-b from-ink-800/80 to-ink-900/80 p-8",
              ci === 1 && "reveal-delay-1",
            ]}
          >
            <h3 class="font-display text-2xl font-semibold text-gold-300">
              {cat.name}
            </h3>
            <ul class="mt-8 space-y-6">
              {cat.items.map((it) => (
                <li class="group border-b border-white/5 pb-6 last:border-0 last:pb-0">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <p class="font-medium text-stone-100 transition group-hover:text-gold-200">
                        {it.n}
                      </p>
                      <p class="mt-1 text-sm text-stone-500">{it.d}</p>
                    </div>
                    <span
                      class="mt-1 h-2 w-2 shrink-0 rounded-full bg-gold-500/50 opacity-0 transition group-hover:opacity-100"
                      aria-hidden="true"
                    />
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
