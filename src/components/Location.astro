---
import { site } from "@/config/site";
---

<section
  id="location"
  class="relative border-t border-white/5 bg-ink-900/30 py-24 md:py-28"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="reveal max-w-2xl">
      <h2 class="font-display text-3xl font-semibold text-stone-50 md:text-4xl">
        Location
      </h2>
      <p class="mt-4 text-stone-400 md:text-lg">
        Zentral gelegen, leicht erreichbar — für spontane Abende genauso wie
        geplante Treffen.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-2 lg:gap-10">
      <div class="reveal rounded-2xl border border-white/10 bg-ink-800/50 p-7">
        <h3 class="font-display text-2xl font-semibold text-gold-300">
          Adresse
        </h3>
        <p class="mt-4 text-sm leading-relaxed text-stone-300">
          {site.name}<br />
          {site.address.street}<br />
          {site.address.zip} {site.address.city}<br />
          {site.address.country}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={site.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-gold-500/40 bg-gold-500/10 px-5 py-2.5 text-sm font-semibold text-gold-300 transition hover:bg-gold-500/20 hover:text-gold-200"
          >
            In Maps öffnen
            <span aria-hidden="true">↗</span>
          </a>
          <a
            href="#kontakt"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-stone-200 transition hover:border-gold-500/35 hover:bg-white/10 hover:text-gold-300"
          >
            Kontakt aufnehmen
          </a>
        </div>
      </div>

      <div
        class="reveal reveal-delay-1 overflow-hidden rounded-2xl border border-white/10 bg-ink-800/40"
      >
        <div class="p-7">
          <h3 class="font-display text-2xl font-semibold text-stone-100">
            Anfahrt
          </h3>
          <p class="mt-3 text-sm text-stone-400">
            Tipp: Öffentliche Parkmöglichkeiten & kurze Wege — Details gern auf
            Anfrage.
          </p>
        </div>
        <div class="relative aspect-[16/10] bg-ink-950">
          <a
            href={site.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group absolute inset-0 grid place-items-center"
            aria-label="Karte in Google Maps öffnen"
          >
            <div
              class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_30%,rgba(201,162,39,0.18),transparent_55%)] opacity-90"
              aria-hidden="true"
            />
            <div
              class="relative mx-6 rounded-2xl border border-white/10 bg-ink-900/70 px-6 py-5 text-center backdrop-blur"
            >
              <p class="text-sm font-semibold text-stone-100">
                Karte öffnen
              </p>
              <p class="mt-1 text-xs text-stone-500">
                (öffnet extern in Maps)
              </p>
              <p
                class="mt-4 inline-flex items-center gap-2 rounded-full bg-gold-500 px-5 py-2.5 text-sm font-semibold text-ink-950 transition group-hover:-translate-y-0.5 group-hover:bg-gold-400"
              >
                Route starten <span aria-hidden="true">→</span>
              </p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

