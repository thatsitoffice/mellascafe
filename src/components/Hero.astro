---
import { site } from "@/config/site";
---

<section
  id="top"
  class="relative flex min-h-[100svh] flex-col justify-end overflow-hidden pb-24 pt-28 md:pb-32 md:pt-36"
>
  <div class="absolute inset-0 -z-20 bg-ink-950" aria-hidden="true"></div>
  <div
    class="absolute inset-0 -z-10 bg-hero-gradient opacity-90"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-[url('/hero-bg.jpg')] bg-cover bg-center opacity-35"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-ink-950/80 to-ink-950/20"
    aria-hidden="true"
  >
  </div>

  <div
    class="pointer-events-none absolute -right-24 top-1/4 h-72 w-72 rounded-full bg-gold-500/10 blur-3xl animate-float"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -left-32 bottom-1/3 h-80 w-80 rounded-full bg-wine-600/20 blur-3xl animate-float"
    style="animation-delay: -2s;"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <p
      class="reveal mb-4 inline-flex items-center gap-2 rounded-full border border-gold-500/25 bg-white/5 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.2em] text-gold-400"
    >
      Café · Lounge · Bar
    </p>
    <h1
      class="reveal reveal-delay-1 font-display text-4xl font-semibold leading-[1.1] tracking-tight text-stone-50 sm:text-5xl md:text-6xl lg:text-7xl"
    >
      <span class="text-gradient-gold">{site.name}</span>
      <span class="mt-2 block text-2xl font-normal text-stone-300 sm:text-3xl md:text-4xl"
        >{site.tagline}</span
      >
    </h1>
    <p
      class="reveal reveal-delay-2 mt-6 max-w-2xl text-lg text-stone-400 md:text-xl"
    >
      {site.description}
    </p>
    <div
      class="reveal reveal-delay-3 mt-10 flex flex-wrap items-center gap-4"
    >
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group relative inline-flex items-center justify-center overflow-hidden rounded-full bg-gold-500 px-8 py-3.5 text-base font-semibold text-ink-950 shadow-xl shadow-gold-500/25 transition duration-300 hover:-translate-y-0.5 hover:shadow-gold-400/40"
      >
        <span
          class="absolute inset-0 bg-gradient-to-r from-transparent via-white/25 to-transparent opacity-0 transition duration-500 group-hover:opacity-100 group-hover:animate-shimmer"
          style="background-size: 200% 100%;"
          aria-hidden="true"
        ></span>
        <span class="relative">Jetzt Platz sichern</span>
      </a>
      <a
        href="#karte"
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3.5 text-base font-medium text-stone-200 backdrop-blur-sm transition duration-300 hover:border-gold-500/40 hover:bg-white/10 hover:text-gold-300"
      >
        Speise- & Getränkekarte
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
    </div>
  </div>

  <a
    href="#vorteile"
    class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 text-stone-500 transition hover:text-gold-400"
    aria-label="Weiter zu Vorteilen"
  >
    <span class="text-xs uppercase tracking-widest">Scroll</span>
    <span
      class="flex h-10 w-6 justify-center rounded-full border border-white/20 pt-2"
    >
      <span
        class="h-2 w-1 animate-bounce rounded-full bg-gold-500/80"
      ></span>
    </span>
  </a>
</section>
