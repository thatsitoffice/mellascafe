---
const images = [
  { src: "/gallery-1.jpg", alt: "Lounge-Detail mit Steinwand" },
  { src: "/gallery-2.jpg", alt: "Bar-Ambiente" },
  { src: "/gallery-3.jpg", alt: "Sitzbereich" },
];
---

<section id="stimmung" class="relative py-24 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="reveal max-w-2xl">
      <h2 class="font-display text-3xl font-semibold text-stone-50 md:text-4xl">
        Atmosphäre
      </h2>
      <p class="mt-4 text-stone-400 md:text-lg">
        Materialien, Licht und Akustik sind bewusst gedämpft — damit Stimmen,
        Gläser und Musik im richtigen Verhältnis bleiben.
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-3">
      {
        images.map((img, i) => (
          <figure
            class:list={[
              "reveal group relative aspect-[4/5] overflow-hidden rounded-2xl border border-white/10 bg-ink-800 sm:aspect-[3/4]",
              i === 1 && "reveal-delay-1 sm:mt-8",
              i === 2 && "reveal-delay-2 sm:mt-4",
            ]}
          >
            <img
              src={img.src}
              alt={img.alt}
              class="h-full w-full object-cover transition duration-700 group-hover:scale-105 group-hover:brightness-110"
              loading="lazy"
              width="600"
              height="800"
            />
            <figcaption class="sr-only">{img.alt}</figcaption>
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-60 transition group-hover:opacity-40"
              aria-hidden="true"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>
