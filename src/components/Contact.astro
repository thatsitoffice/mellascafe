---
import { site } from "@/config/site";

const hasEndpoint = Boolean(site.crmFormAction);
---

<section
  id="kontakt"
  class="relative border-t border-white/5 bg-ink-900/40 py-24 md:py-28"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="reveal">
        <h2 class="font-display text-3xl font-semibold text-stone-50 md:text-4xl">
          Kontakt
        </h2>
        <p class="mt-4 text-stone-400 md:text-lg">
          Für Fragen, Events oder Sonderwünsche — wir melden uns zeitnah zurück.
        </p>
        <dl class="mt-10 space-y-6 text-sm">
          <div>
            <dt class="font-medium uppercase tracking-wider text-gold-500/90">
              Adresse
            </dt>
            <dd class="mt-1 text-stone-300">
              {site.address.street}<br />
              {site.address.zip}
              {site.address.city}<br />
              {site.address.country}
            </dd>
          </div>
          <div>
            <dt class="font-medium uppercase tracking-wider text-gold-500/90">
              Telefon
            </dt>
            <dd class="mt-1">
              <a
                href={`tel:${site.contact.phone.replace(/\s/g, "")}`}
                class="text-stone-300 transition hover:text-gold-300"
              >
                {site.contact.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-medium uppercase tracking-wider text-gold-500/90">
              E-Mail
            </dt>
            <dd class="mt-1">
              <a
                href={`mailto:${site.contact.email}`}
                class="text-stone-300 transition hover:text-gold-300"
              >
                {site.contact.email}
              </a>
            </dd>
          </div>
        </dl>
        {
          !hasEndpoint && (
            <p class="mt-8 rounded-xl border border-gold-500/25 bg-gold-500/5 p-4 text-sm text-stone-400">
              <strong class="text-gold-300">CRM-Anbindung:</strong> Tragen Sie in
              der Datei <code class="rounded bg-white/10 px-1.5 py-0.5 text-xs">
                .env
              </code> die Variable{" "}
              <code class="rounded bg-white/10 px-1.5 py-0.5 text-xs">
                PUBLIC_CRM_FORM_ACTION
              </code>{" "}
              mit der Post-URL Ihres CRM/Webhooks ein. Bis dahin öffnet Absenden
              Ihr E-Mail-Programm mit vorgefülltem Text.
            </p>
          )
        }
      </div>

      <div class="reveal reveal-delay-1">
        <form
          id="crm-form"
          class="rounded-2xl border border-white/10 bg-ink-800/50 p-6 shadow-xl backdrop-blur-sm md:p-8"
          method={hasEndpoint ? "post" : "get"}
          action={hasEndpoint ? site.crmFormAction : undefined}
          data-endpoint={hasEndpoint ? "1" : ""}
          data-mailto={site.contact.email}
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block sm:col-span-1">
              <span class="text-xs font-medium text-stone-400">Name</span>
              <input
                name="name"
                required
                autocomplete="name"
                class="mt-1.5 w-full rounded-xl border border-white/10 bg-ink-950/60 px-4 py-3 text-stone-100 outline-none ring-gold-500/30 transition placeholder:text-stone-600 focus:border-gold-500/40 focus:ring-2"
                placeholder="Vor- und Nachname"
              />
            </label>
            <label class="block sm:col-span-1">
              <span class="text-xs font-medium text-stone-400">E-Mail</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="mt-1.5 w-full rounded-xl border border-white/10 bg-ink-950/60 px-4 py-3 text-stone-100 outline-none ring-gold-500/30 transition placeholder:text-stone-600 focus:border-gold-500/40 focus:ring-2"
                placeholder="name@beispiel.de"
              />
            </label>
            <label class="block sm:col-span-2">
              <span class="text-xs font-medium text-stone-400">Betreff</span>
              <input
                name="subject"
                class="mt-1.5 w-full rounded-xl border border-white/10 bg-ink-950/60 px-4 py-3 text-stone-100 outline-none ring-gold-500/30 transition placeholder:text-stone-600 focus:border-gold-500/40 focus:ring-2"
                placeholder="z. B. Eventanfrage"
              />
            </label>
            <label class="block sm:col-span-2">
              <span class="text-xs font-medium text-stone-400">Nachricht</span>
              <textarea
                name="message"
                required
                rows="5"
                class="mt-1.5 w-full resize-y rounded-xl border border-white/10 bg-ink-950/60 px-4 py-3 text-stone-100 outline-none ring-gold-500/30 transition placeholder:text-stone-600 focus:border-gold-500/40 focus:ring-2"
                placeholder="Wie können wir helfen?"
              />
            </label>
          </div>
          <p class="mt-4 text-xs text-stone-500">
            Mit dem Absenden akzeptieren Sie unsere Hinweise in der{" "}
            <a href="/datenschutz" class="text-gold-400 underline hover:text-gold-300"
              >Datenschutzerklärung</a
            >.
          </p>
          <button
            type="submit"
            class="mt-6 w-full rounded-full bg-gold-500 py-3.5 text-sm font-semibold text-ink-950 transition hover:bg-gold-400 sm:w-auto sm:px-10"
          >
            Nachricht senden
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById("crm-form");
    if (!form || form.getAttribute("data-endpoint")) return;
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var data = new FormData(form);
      var name = String(data.get("name") || "");
      var email = String(data.get("email") || "");
      var subject = String(data.get("subject") || "");
      var message = String(data.get("message") || "");
      var mailto = form.getAttribute("data-mailto") || "";
      var body = "Name: " + name + "\nE-Mail: " + email + "\n\n" + message;
      var line =
        "mailto:" +
        mailto +
        "?subject=" +
        encodeURIComponent(subject || "Kontaktanfrage Website") +
        "&body=" +
        encodeURIComponent(body);
      window.location.href = line;
    });
  })();
</script>
