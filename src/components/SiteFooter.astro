---
import { site } from "@/config/site";
---

<footer class="border-t border-white/10 bg-ink-950 pb-12 pt-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="reveal">
        <p class="font-display text-lg font-semibold text-stone-100">
          {site.name}
        </p>
        <p class="mt-3 text-sm text-stone-500">{site.tagline}</p>
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-sm text-stone-400 transition hover:text-gold-300"
        >
          Instagram
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="reveal reveal-delay-1">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-gold-500/90">
          Öffnungszeiten
        </h3>
        <ul class="mt-4 space-y-3 text-sm text-stone-400">
          {
            site.openingHours.map((row) => (
              <li class="flex justify-between gap-4 border-b border-white/5 pb-2 last:border-0">
                <span class="text-stone-300">{row.days}</span>
                <span>{row.hours}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reveal reveal-delay-2">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-gold-500/90">
          Kontakt
        </h3>
        <address class="mt-4 not-italic text-sm text-stone-400">
          {site.address.street}<br />
          {site.address.zip}
          {site.address.city}
          <br /><br />
          <a
            href={`tel:${site.contact.phone.replace(/\s/g, "")}`}
            class="transition hover:text-gold-300"
          >
            {site.contact.phone}
          </a>
          <br />
          <a
            href={`mailto:${site.contact.email}`}
            class="transition hover:text-gold-300"
          >
            {site.contact.email}
          </a>
        </address>
      </div>
      <div class="reveal reveal-delay-3">
        <h3 class="text-xs font-semibold uppercase tracking-widest text-gold-500/90">
          Rechtliches
        </h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a
              href="/impressum"
              class="text-stone-400 transition hover:text-gold-300"
            >
              Impressum
            </a>
          </li>
          <li>
            <a
              href="/datenschutz"
              class="text-stone-400 transition hover:text-gold-300"
            >
              Datenschutz
            </a>
          </li>
        </ul>
        <p class="mt-6 text-xs text-stone-600">
          © {new Date().getFullYear()}
          {site.name}. Alle Rechte vorbehalten.
        </p>
      </div>
    </div>
  </div>
</footer>
